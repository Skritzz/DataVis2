{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Monthly patronage by transport mode with corresponding contributions to the system total.",
  "config": {
    "font": "Inter, system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Arial, sans-serif",
    "axis": {"labelColor": "#333", "titleColor": "#333"},
    "axisQuantitative": {"format": ",d"},
    "legend": {"labelColor": "#333", "titleColor": "#333"},
    "range": {
      "category": ["#264653", "#2a9d8f", "#e9c46a", "#f4a261", "#e76f51", "#8ab17d"],
      "ordinal": ["#fdf6e3", "#f4ce82", "#e9a64d", "#d36931", "#b23a22"],
      "ramp": ["#fdf6e3", "#f4ce82", "#e9a64d", "#d36931", "#b23a22"],
      "heatmap": ["#fdf6e3", "#f4ce82", "#e9a64d", "#d36931", "#b23a22"]
    }
  },
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {
    "url": "data/monthly_public_transport_patronage_by_mode.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "fold": [
        "Metropolitan train",
        "Metropolitan tram",
        "Metropolitan bus",
        "Regional train",
        "Regional coach",
        "Regional bus"
      ],
      "as": ["Mode", "Patronage"]
    },
    {"calculate": "toNumber(replace('' + datum.Patronage, ',', ''))", "as": "pax"},
    {
      "calculate": "datetime(toNumber(datum.Year), toNumber(datum.Month) - 1, 1)",
      "as": "date"
    },
    {"filter": "isFinite(datum.pax)"}
  ],
  "resolve": {
    "scale": {"color": "shared"},
    "legend": {"color": "shared"}
  },
  "spacing": 32,
  "vconcat": [
    {
      "title": {"text": "Monthly Public Transport Patronage by Mode (2018–2025)", "anchor": "start"},
      "width": 1100,
      "height": 500,
      "params": [
        {
          "name": "modePick",
          "select": {"type": "point", "fields": ["Mode"], "toggle": "true"},
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "strokeWidth": 2,
        "point": {"filled": true, "size": 20}
      },
      "encoding": {
        "x": {"field": "date", "type": "temporal", "title": "Month"},
        "y": {
          "field": "pax",
          "type": "quantitative",
          "title": "Monthly patronage",
          "axis": {"format": ",d"}
        },
        "color": {
          "field": "Mode",
          "type": "nominal",
          "title": "Mode",
          "scale": {"range": ["#264653", "#2a9d8f", "#e9c46a", "#f4a261", "#e76f51", "#8ab17d"]},
          "legend": {"orient": "bottom", "direction": "horizontal", "title": "Mode"}
        },
        "detail": {"field": "Mode"},
        "opacity": {"condition": {"param": "modePick", "value": 1}, "value": 0.2},
        "tooltip": [
          {"field": "Mode"},
          {"field": "Year"},
          {"field": "Month name", "title": "Month"},
          {"field": "pax", "title": "Patronage", "format": ",d"}
        ]
      }
    },
    {
      "title": {"text": "Mode Contribution to Monthly Patronage", "anchor": "start"},
      "width": 1100,
      "height": 500,
      "transform": [
        {
          "joinaggregate": [
            {"op": "sum", "field": "pax", "as": "monthTotal"}
          ],
          "groupby": ["date"]
        },
        {
          "calculate": "datum.monthTotal > 0 ? datum.pax / datum.monthTotal : 0",
          "as": "share"
        }
      ],
      "mark": {
        "type": "area",
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {"field": "date", "type": "temporal", "title": "Month"},
        "y": {
          "field": "pax",
          "type": "quantitative",
          "title": "Monthly patronage",
          "stack": "zero",
          "axis": {"format": ",d"}
        },
        "color": {
          "field": "Mode",
          "type": "nominal",
          "title": "Mode",
          "scale": {"range": ["#264653", "#2a9d8f", "#e9c46a", "#f4a261", "#e76f51", "#8ab17d"]},
          "legend": null
        },
        "opacity": {
          "condition": {"param": "modePick", "value": 1},
          "value": 0.3
        },
        "order": {"field": "share", "type": "quantitative"},
        "tooltip": [
          {"field": "Mode"},
          {"field": "Year"},
          {"field": "Month name", "title": "Month"},
          {"field": "pax", "title": "Patronage", "format": ",d"},
          {"field": "monthTotal", "title": "Monthly total", "format": ",d"},
          {"field": "share", "title": "Mode share", "format": ".1%"}
        ]
      }
    }
  ]
}
