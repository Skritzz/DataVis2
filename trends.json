{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Monthly patronage by transport mode with corresponding contributions to the system total.",
  "config": {
    "font": "VicSans, system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Arial, sans-serif",
    "axis": {"labelColor": "#333f48", "titleColor": "#333f48"},
    "axisQuantitative": {"format": ",d"},
    "legend": {"labelColor": "#333f48", "titleColor": "#333f48"},
    "range": {
      "category": ["#00a3ad", "#f26d04", "#6e2585", "#333f48", "#75787b", "#7ba3d7"],
      "ordinal": ["#e0f6f7", "#b9e4e6", "#5dc3c8", "#00767f", "#333f48"],
      "ramp": ["#e0f6f7", "#b9e4e6", "#5dc3c8", "#00767f", "#333f48"],
      "heatmap": ["#e0f6f7", "#b9e4e6", "#5dc3c8", "#00767f", "#333f48"]
    }
  },
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {
    "url": "data/monthly_public_transport_patronage_by_mode.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "fold": [
        "Metropolitan train",
        "Metropolitan tram",
        "Metropolitan bus",
        "Regional train",
        "Regional coach",
        "Regional bus"
      ],
      "as": ["Mode", "Patronage"]
    },
    {"calculate": "toNumber(replace('' + datum.Patronage, ',', ''))", "as": "pax"},
    {
      "calculate": "datetime(toNumber(datum.Year), toNumber(datum.Month) - 1, 1)",
      "as": "date"
    },
    {"filter": "isFinite(datum.pax)"}
  ],
  "resolve": {
    "scale": {"color": "shared"},
    "legend": {"color": "shared"}
  },
  "spacing": 32,
  "vconcat": [
    {
      "title": {"text": "Monthly Public Transport Patronage by Mode (2018–2025)", "anchor": "start"},
      "width": 1100,
      "height": 500,
      "layer": [
        {
          "params": [
            {
              "name": "modePick",
              "select": {"type": "point", "fields": ["Mode"], "toggle": "true"},
              "bind": "legend"
            }
          ],
          "mark": {
            "type": "line",
            "interpolate": "monotone",
            "strokeWidth": 2,
            "point": {"filled": true, "size": 20}
          },
          "encoding": {
            "x": {"field": "date", "type": "temporal", "title": "Month"},
            "y": {
              "field": "pax",
              "type": "quantitative",
              "title": "Monthly patronage",
              "axis": {"format": ",d"}
            },
            "color": {
              "field": "Mode",
              "type": "nominal",
              "title": "Mode",
              "scale": {"range": ["#00a3ad", "#f26d04", "#6e2585", "#333f48", "#75787b", "#7ba3d7"]},
              "legend": {"orient": "bottom", "direction": "horizontal", "title": "Mode"}
            },
            "detail": {"field": "Mode"},
            "opacity": {"condition": {"param": "modePick", "value": 1}, "value": 0.2},
            "tooltip": [
              {"field": "Mode"},
              {"field": "Year"},
              {"field": "Month name", "title": "Month"},
              {"field": "pax", "title": "Patronage", "format": ",d"}
            ]
        }
        },
        {
          "data": {
            "values": [
              {
                "Year": 2020,
                "Month": 4,
                "pax": 2165747,
                "label": "April 2020 lockdown low",
                "labelDate": "2020-04-01",
                "labelPax": 12000000
              },
              {
                "Year": 2021,
                "Month": 9,
                "pax": 2769485,
                "label": "Sept 2021 lockdown low",
                "labelDate": "2021-09-01",
                "labelPax": 11000000
              }
            ]
          },
          "transform": [
            {"calculate": "datetime(datum.Year, datum.Month - 1, 1)", "as": "annDate"},
            {"calculate": "toDate(datum.labelDate)", "as": "labelDateParsed"}
          ],
          "layer": [
            {
              "mark": {
                "type": "point",
                "filled": true,
                "size": 120,
                "shape": "triangle-down",
                "stroke": "#333f48",
                "strokeWidth": 0.6,
                "color": "#333f48"
              },
              "encoding": {
                "x": {"field": "annDate", "type": "temporal"},
                "y": {"field": "pax", "type": "quantitative"}
              }
            },
            {
              "mark": {"type": "rule", "strokeWidth": 1.2, "strokeDash": [4, 2]},
              "encoding": {
                "x": {"field": "labelDateParsed", "type": "temporal"},
                "y": {"field": "labelPax", "type": "quantitative"},
                "x2": {"field": "annDate"},
                "y2": {"field": "pax"},
                "color": {"value": "#333f48"}
              }
            },
            {
              "mark": {"type": "text", "fontSize": 12, "fontWeight": "bold", "color": "#333f48"},
              "encoding": {
                "x": {"field": "labelDateParsed", "type"