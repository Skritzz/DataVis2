{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Melbourne train stations — proportional map and linked bar chart with passenger threshold slider.",
  "config": {
    "font": "VicSans, system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Arial, sans-serif",
    "axis": {"labelColor": "#333f48", "titleColor": "#333f48"},
    "axisQuantitative": {"format": ",d"},
    "legend": {"labelColor": "#333f48", "titleColor": "#333f48"},
    "range": {
      "category": ["#00a3ad", "#f26d04", "#6e2585", "#333f48", "#75787b", "#7ba3d7"],
      "ordinal": ["#e0f6f7", "#b9e4e6", "#5dc3c8", "#00767f", "#333f48"],
      "ramp": ["#e0f6f7", "#b9e4e6", "#5dc3c8", "#00767f", "#333f48"],
      "heatmap": ["#e0f6f7", "#b9e4e6", "#5dc3c8", "#00767f", "#333f48"]
    }
  },

  "autosize": {"type": "fit", "contains": "padding"},
  "spacing": 20,

  "params": [
    {
      "name": "minPax",
      "value": 0,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 20000000,
        "step": 500000,
        "name": "Minimum annual passenger entries: "
      }
    }
  ],

  "vconcat": [
    {
      "title": {
        "text": "Melbourne Train Stations: Annual Passenger Entries (FY2023–24)",
        "subtitle": "Circles scale with annual entries. Metropolitan Melbourne outline provides geographic context.",
        "anchor": "start",
        "fontWeight": "bold"
      },
      "width": 1000,
      "height": 500,
      "view": {"stroke": null},
      "projection": {"type": "mercator", "center": [144.07, -37.54], "scale": 35000},
      "layer": [
        {
          "data": {
            "url": "data/FINALvicmap.json",
            "format": {"type": "json"}
          },
          "mark": {
            "type": "geoshape",
            "fill": "#fdf6e3",
            "fillOpacity": 0.3,
            "stroke": "#f4a261",
            "strokeWidth": 1.1
          }
        },
        {
          "data": {
            "url": "data/annual_metropolitan_train_station_entries_fy_2023_2024.csv",
            "format": {"type": "csv"}
          },
          "transform": [
            {"calculate": "toNumber(replace(datum.Stop_long, ',', ''))", "as": "lon"},
            {"calculate": "toNumber(replace(datum.Stop_lat, ',', ''))", "as": "lat"},
            {"calculate": "toNumber(replace(datum.Pax_annual, ',', ''))", "as": "pax"},
            {"filter": "isFinite(datum.lon) && isFinite(datum.lat) && isFinite(datum.pax)"},
            {"window": [{"op": "rank", "as": "rk"}], "sort": [{"field": "pax", "order": "descending"}]},
            {"calculate": "datum.rk <= 10", "as": "isTop10"},
                {"filter": "datum.pax >= minPax"},
                {"calculate": "datum.pax > 0 ? datum.pax : 1", "as": "size_safe"}
              ],
              "mark": {"type": "circle", "opacity": 0.85, "stroke": "#264653", "strokeWidth": 0.3},
              "encoding": {
                "longitude": {"field": "lon", "type": "quantitative"},
                "latitude": {"field": "lat", "type": "quantitative"},
                "size": {
                  "field": "size_safe",
                  "type": "quantitative",
                  "scale": {"type": "sqrt", "range": [10, 680]},
                  "title": "Annual passenger entries"
                },
            "color": {
              "condition": {"test": "datum.isTop10", "value": "#f26d04"},
              "value": "#00a3ad"
            },
            "tooltip": [
              {"field": "Stop_name", "title": "Station"},
              {"field": "pax", "title": "Annual passenger entries", "format": ",d"}
            ]
          }
        }
      ]
    },

    {
      "width": 1000,
      "height": 28,
      "data": {
        "values": [
          {
            "text": "Use the slider to surface quieter stations and see how the spatial footprint shifts as you drop the threshold."
          }
        ]
      },
      "mark": {"type": "text", "align": "left", "baseline": "middle"},
      "encoding": {
        "x": {"value": 0},
        "y": {"value": 14},
        "text": {"field": "text"},
        "color": {"value": "#333f48"},
        "size": {"value": 12}
      }
    },

    {
      "title": {"text": "Top 10 Stations by Annual Passenger Entries(FY2023–24)", "anchor": "start"},
      "width": 1000,
      "height": 500,
      "data": {
        "url": "data/annual_metropolitan_train_station_entries_fy_2023_2024.csv",
        "format": {"type": "csv"}
      },
      "transform": [
        {"calculate": "toNumber(replace(datum.Pax_annual, ',', ''))", "as": "pax"},
        {"filter": "isFinite(datum.pax) && datum.pax >= minPax"},
        {"window": [{"op": "rank", "as": "rk"}], "sort": [{"field": "pax", "order": "descending"}]},
        {"filter": "datum.rk <= 10"}
      ],
      "mark": {"type": "bar", "cornerRadiusEnd": 2},
      "encoding": {
        "y": {
          "field": "Stop_name",
          "type": "nominal",
          "sort": "-x",
          "title": "Station"
        },
        "x": {
          "field": "pax",
          "type": "quantitative",
          "title": "Annual passenger entries",
          "axis": {"format": ",d", "tickCount": 4}
        },
        "color": {
          "field": "pax",
          "type": "quantitative",
          "title": "Annual passenger entries",
          "scale": {"range": ["#e0f6f7", "#b9e4e6", "#5dc3c8", "#00767f", "#333f48"]},
          "legend": null
        },
        "tooltip": [
          {"field": "Stop_name", "title": "Station"},
          {"field": "pax", "title": "Annual passenger entries", "format": ",d"}
        ]
      }
    },

    {
      "width": 600,
      "height": 20,
      "data": {"values": [{}]},
      "transform": [
        {"calculate": "'Minimum annual passenger entries: ' + format(minPax, ',d')", "as": "label"}
      ],
      "mark": {"type": "text", "align": "left", "baseline": "middle"},
      "encoding": {
        "x": {"value": 0},
        "y": {"value": 11},
        "text": {"field": "label"},
        "color": {"value": "#333f48"},
        "size": {"value": 11}
      }
    }
  ],

  "resolve": {"scale": {"size": "independent"}}
}
